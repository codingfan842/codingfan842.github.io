        cursors.clear()
        clearInterval(ping)
    })

    function sendPos(x, y) {
        if (ws.readyState !== WebSocket.OPEN) return
        if (settings.relative) {
            x = Math.round((x / document.documentElement.scrollWidth) * 65535)
            y = Math.round((y / document.documentElement.scrollHeight) * 65535)
