    const ws = new WebSocket(`wss://menal.xyz/widgets/cursors/ws?iid=${encodeURIComponent(iid)}`)
    ws.binaryType = "arraybuffer"

    const cursors = new Map()

    function getCursorEl(id) {
        let curr = cursors.get(id)
        if (!curr) {
            curr = document.createElement("div")
            curr.className = "cursor-widget-cursor"
            curr.innerHTML = CURSOR_SVG
            document.body.appendChild(curr)
            cursors.set(id, curr)
